# Copy to `.env` and fill in. All VITE_* vars are embedded at BUILD time,
# so you must rebuild (not just reload) after changing them.

# REQUIRED — without this the game cannot start.
# Create at https://console.cloud.google.com/apis/credentials and restrict it to:
#   Application restrictions: HTTP referrers -> your deployed origin(s)
#   API restrictions: Maps JavaScript API, Places API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=

# OPTIONAL — only powers AI-generated clues via the `generate-clue` edge
# function. Leave blank to run the game with static fallback clues.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
